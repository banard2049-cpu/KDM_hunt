# --- Runtime / generated ---
# User save data is created at runtime and must not be committed.
saves/

# Python cache (server.py)
__pycache__/
*.py[cod]
*.egg-info/

# Local build output (if a dist folder is produced)
dist/

# --- Image assets (managed via GitHub Release) ---
# Core game assets are excluded from the repository to keep it lightweight.
# They are automatically downloaded during CI builds from GitHub Release.
# See docs/ASSETS_MANAGEMENT.md for details.

# Core game assets (downloaded from Release)
assets/board/
assets/cards/
assets/hunt-backs/
assets/hunt-sheets/
assets/loot/*
!assets/loot/kings-man-core.jpg

# --- Private HD assets (not uploaded anywhere) ---
# High-resolution (HD) images are private and kept locally only.
# These are never committed to Git or uploaded to Release.
assets/cards/rulebook-hd/
assets/loot/hd/
assets/**/hd/
*-hd.*
*_hd.*

# --- Local builds ---
# APK files built locally should not be committed
*.apk
kdm-hunt-assets.tar.gz

# --- Android / Capacitor (generated at build time by CI, not committed) ---
/android/
www/
node_modules/

# --- Research / scratch ---
.research-scratch/
.npm-cache-tmp/

# --- Maintenance / development tools ---
.maintenance/
.claude/

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editors / tooling ---
.idea/
.vscode/
*.swp
*.tmp
*~

# Imported showdown images follow the existing local asset workflow.
assets/showdown/
